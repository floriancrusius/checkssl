#compdef checkssl
# zsh completion for checkssl
#
# Install to any dir on $fpath, e.g.:
#   /usr/local/share/zsh/site-functions/_checkssl
# Or in-shell:
#   eval "$(checkssl completion zsh)"

_checkssl() {
    _arguments -s -S \
        '(-d --domain)'{-d,--domain}'[domain to check (repeatable)]:domain:' \
        '(-f --file)'{-f,--file}'[file with one domain per line]:file:_files' \
        '(-s --silent)'{-s,--silent}'[suppress error output]' \
        '--format[output format]:format:(table csv json nagios html)' \
        '--concurrency[max parallel TLS handshakes]:n:' \
        '--timeout[per-domain handshake timeout]:duration:' \
        '--nagios-warning[warn threshold in days (nagios only)]:n:' \
        '--nagios-critical[critical threshold in days (nagios only)]:n:' \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-v --version)'{-v,--version}'[show version]' \
        '1: :->cmd' \
    && return 0

    case "$state" in
        cmd)
            _values 'sub-command' \
                'completion[print shell completion script]'
            ;;
    esac
}

_checkssl "$@"
